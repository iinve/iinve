// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

model DigitalWall {
  id             String       @id @default(cuid())
  wallId         String       @unique
  categories     Category[]
  products       Product[]
  banners        Banner[]
  newArrivals    NewArrival[]
  spotlightText  String?
  spotlightImage String?
  offers         Json
  createdAt      DateTime     @default(now())

  @@schema("public")
}

model Category {
  id            String      @id @default(cuid())
  name          String
  digitalWallId String
  digitalWall   DigitalWall @relation(fields: [digitalWallId], references: [id])

  @@schema("public")
}

model Product {
  id            String      @id @default(cuid())
  title         String
  weight        String
  image         String?
  categoryName  String
  digitalWallId String
  digitalWall   DigitalWall @relation(fields: [digitalWallId], references: [id])

  @@schema("public")
}

model Banner {
  id            String      @id @default(cuid())
  text          String
  image         String?
  digitalWallId String
  digitalWall   DigitalWall @relation(fields: [digitalWallId], references: [id])

  @@schema("public")
}

model NewArrival {
  id            String      @id @default(cuid())
  title         String
  weight        String
  image         String?
  digitalWallId String
  digitalWall   DigitalWall @relation(fields: [digitalWallId], references: [id])

  @@schema("public")
}

model DigitalWallUser {
  userId    Int    @id @default(autoincrement())
  email     String
  password  String
  wall_slug String
  shop_name String

  @@schema("public")
}
